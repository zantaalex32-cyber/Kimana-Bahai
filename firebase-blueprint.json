{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role and Google auth details",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase user UID" },
        "email": { "type": "string", "description": "User email address" },
        "displayName": { "type": "string", "description": "Full name" },
        "photoURL": { "type": "string", "description": "Avatar URL" },
        "role": { "type": "string", "description": "Access role in cluster" },
        "createdAt": { "type": "string", "description": "Timestamp" }
      },
      "required": ["uid", "email"]
    },
    "Locality": {
      "title": "Locality",
      "description": "Cluster locality details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "bahaiCount": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "ClusterData": {
      "title": "ClusterData",
      "description": "Shared cluster real-time synchronized dataset",
      "type": "object",
      "properties": {
        "items": { "type": "array" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Registered user accounts"
    },
    "/clusterData/{collectionName}": {
      "schema": "ClusterData",
      "description": "Real-time synchronized collections for Kimana cluster"
    },
    "/localities/{localityId}": {
      "schema": "Locality",
      "description": "Kimana Cluster localities"
    }
  }
}
