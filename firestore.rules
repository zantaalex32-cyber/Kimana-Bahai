rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global catch-all default-deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSystemAdmin() {
      return isSignedIn() && request.auth.token.email == 'zantatech9@gmail.com';
    }

    // Users profile collection - only zantatech9@gmail.com is permitted as Administrator
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId) && (
        request.resource.data.role != 'Administrator' || isSystemAdmin()
      );
      allow delete: if false;
    }

    // Shared real-time cluster collections - readable by everyone logged in or in the app, writable by authenticated users
    match /clusterData/{collectionName} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Entity collections
    match /localities/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /people/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /activities/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /studyCircles/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /childrenClasses/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /juniorYouthGroups/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /devotionals/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /homeVisits/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /serviceVisits/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /newBahais/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /followUps/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /cycles/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /auditLogs/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
