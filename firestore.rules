rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global catch-all default-deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSystemAdmin() {
      return isSignedIn() && request.auth.token.email == 'zantatech9@gmail.com';
    }

    // Users profile collection - only zantatech9@gmail.com is permitted as Administrator
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId) && (
        request.resource.data.role != 'Administrator' || isSystemAdmin()
      );
      allow delete: if false;
    }

    // Cluster Localities
    match /localities/{localityId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}
